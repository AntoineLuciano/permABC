\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces {\color  {blue}Over-Sampling pushforward marginals for the Gaussian toy model (\( K=10 \)). Each curve corresponds to one \( M \in \{10,\dots  ,250\} \). Left: marginal on \( \sigma ^2 \) flattens towards the prior as \( M \) grows, in agreement with~\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:os_pushforward_limit}\unskip \@@italiccorr )}}. Right: marginal on \( \mu _1 \) concentrates as the optimal permutation selects the best match among \( M \) candidates.}\relax }}{19}{figure.caption.4}\protected@file@percent }
\newlabel{fig:os}{{2}{19}{\old {Evolution of the pseudo-posterior \( \pi _\varepsilon ^{*M} \) as \( M \) decreases from \( M_0 = 150 \) (yellow) to \( M_T = K = 10 \) (purple) for a Gaussian toy model.}\new {Over-Sampling pushforward marginals for the Gaussian toy model (\( K=10 \)). Each curve corresponds to one \( M \in \{10,\dots ,250\} \). Left: marginal on \( \sigma ^2 \) flattens towards the prior as \( M \) grows, in agreement with~\eqref {eq:os_pushforward_limit}. Right: marginal on \( \mu _1 \) concentrates as the optimal permutation selects the best match among \( M \) candidates.}\relax }{figure.caption.4}{}}
