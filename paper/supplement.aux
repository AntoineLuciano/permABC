\@writefile{lof}{\contentsline {figure}{\numberline {S.3}{\ignorespaces {\color  {blue}Synthetic validation of permABC-SMC on the SIR model (\( K=10 \) compartments). Top: posterior of \( R_0 \) for \( \sigma \in \{0.01, 0.05, 0.10\} \); dashed red line marks the true value. Middle: posteriors of four local recovery rates \( \nu _k \) (\( \sigma =0.05 \)). Bottom: posterior predictive checks---envelopes (50\% dark, 90\% light) of simulated trajectories vs.\ synthetic observed data (solid black). The method recovers the true parameters in all cases.}}}{19}{figure.3}\protected@file@percent }
\newlabel{fig:sir_synthetic}{{S.3}{19}{\new {Synthetic validation of permABC-SMC on the SIR model (\( K=10 \) compartments). Top: posterior of \( R_0 \) for \( \sigma \in \{0.01, 0.05, 0.10\} \); dashed red line marks the true value. Middle: posteriors of four local recovery rates \( \nu _k \) (\( \sigma =0.05 \)). Bottom: posterior predictive checks---envelopes (50\% dark, 90\% light) of simulated trajectories vs.\ synthetic observed data (solid black). The method recovers the true parameters in all cases.}}{figure.3}{}}
